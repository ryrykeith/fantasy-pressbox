{
  "name": "fantasy-pressbox",
  "version": "0.1.0",
  "description": "AI-powered fantasy football league coverage from Sleeper data: power rankings, previews, recaps, awards, and trash talk.",
  "keywords": [
    "fantasy-football",
    "sleeper",
    "dynasty",
    "guillotine",
    "power-rankings",
    "cli",
    "ai"
  ],
  "license": "MIT",
  "author": "ryrykeith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryrykeith/fantasy-pressbox.git"
  },
  "homepage": "https://github.com/ryrykeith/fantasy-pressbox#readme",
  "bugs": {
    "url": "https://github.com/ryrykeith/fantasy-pressbox/issues"
  },
  "type": "module",
  "bin": {
    "fantasy-pressbox": "src/cli.mjs"
  },
  "exports": {
    "./core": "./src/core/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "prompts/",
    "config/editorial.yml",
    "config/rankings.yml",
    "config/bye-weeks.*.yml",
    "config/prospects.example.yml",
    "config/rookie-draft.yml",
    "config/guillotine.yml",
    "config/rivalries.yml",
    "setup.mjs",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "npm test && node scripts/check-pack.mjs",
    "setup": "node setup.mjs",
    "start": "node src/cli.mjs",
    "fetch": "node src/cli.mjs fetch",
    "preview": "node src/cli.mjs preview",
    "recap": "node src/cli.mjs recap",
    "rankings": "node src/cli.mjs rankings",
    "doctor": "node src/cli.mjs doctor"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {}
}
