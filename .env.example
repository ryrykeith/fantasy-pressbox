# ============================================================================
# Fantasy Pressbox — settings
#
# Copy this file to ".env" and fill it in, or just run:  fantasy-pressbox init
# (from a clone: npm run setup). The folder holding .env is the league's folder.
# The .env file stays on your computer. It is never committed to git.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — your league
# ----------------------------------------------------------------------------

# The long number in your Sleeper league's web address.
# Open https://sleeper.com in a browser, go to your league, and copy the digits:
#   https://sleeper.com/leagues/1234567890123456789/team
#                               ^^^^^^^^^^^^^^^^^^^
# Sleeper's API is public and read-only, so no Sleeper password is needed.
SLEEPER_LEAGUE_ID=

# ----------------------------------------------------------------------------
# ESPN leagues (EXPERIMENTAL) — leave all of these empty for a Sleeper league
# ----------------------------------------------------------------------------

# Which platform the league is on: sleeper | espn. Empty means sleeper.
LEAGUE_PROVIDER=

# The number after leagueId= in your ESPN league's web address.
ESPN_LEAGUE_ID=

# How ESPN data arrives: import | fetch. Empty means import.
#   import  the default: you save the league's data from ESPN yourself and
#           import it. Nothing is requested from ESPN for you.
#   fetch   automated access: Fantasy Pressbox asks ESPN's servers itself.
#           It is opt-in, and you choose it under ESPN's terms of use.
ESPN_ROUTE=

# ESPN_S2 and ESPN_SWID are PASSWORDS: they let anyone act as you on ESPN.
# They are needed only for a PRIVATE league on the fetch route, and
# both or neither must be set. They are never read when ESPN_ROUTE is import.
# They go in this file and nowhere else: never paste them into a chat, an
# issue, a post or a file you share.
ESPN_S2=
ESPN_SWID=

# What kind of league it is: dynasty | redraft | guillotine
#
#   dynasty      rosters carry between seasons, so future picks are real assets
#   redraft      rosters are torn up and drafted again every season
#   guillotine   no head-to-head record; the lowest scorer each week is out
#
# Leave this empty and Fantasy Pressbox works it out from Sleeper. It can tell
# dynasty from redraft on its own, but NOT guillotine: that format is run by
# the commissioner by hand, so Sleeper still reports an ordinary league. If
# yours is a guillotine league, you have to say so here.
#
# A value that isn't one of the three above stops the command with an error
# rather than quietly guessing. Run `fantasy-pressbox doctor` to see what the
# tool decided your league is.
LEAGUE_FORMAT=

# ----------------------------------------------------------------------------
# OPTIONAL — writing the posts for you
#
# Leave these empty to use Fantasy Pressbox for free: it writes a prompt file
# that you paste into ChatGPT or Claude yourself.
#
# Fill one in to use the --generate flag, which writes finished posts straight
# to the output folder. That calls a paid API and costs money per run.
# ----------------------------------------------------------------------------

# Which service to use when both keys are present: anthropic | openai
AI_PROVIDER=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# From https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which model to use. Leave empty with Anthropic to get a sensible default.
# Required for OpenAI.
AI_MODEL=

# ----------------------------------------------------------------------------
# OPTIONAL — overrides
#
# Season and week are worked out from the platform automatically. Set these
# only to force a specific value, and remember to clear them again afterwards.
# ----------------------------------------------------------------------------

# A four-digit year. An ESPN league needs it. (SLEEPER_SEASON still works.)
LEAGUE_SEASON=
FANTASY_WEEK=

# What to call your league in print, if not the platform's name for it.
LEAGUE_DISPLAY_NAME=

# Quick overrides for config/editorial.yml.
# Tone: humorous | analytical | dry | unhinged (default humorous).
PRESSBOX_TONE=
# Longest post, in characters (default 900). (SLEEPER_POST_MAX_LENGTH still works.)
POST_MAX_LENGTH=
# true | false (default true). false turns rank emoji off; --emoji none does it for one run.
INCLUDE_EMOJI=

# ----------------------------------------------------------------------------
# OPTIONAL — where files go
# ----------------------------------------------------------------------------

# Blank means data/ and output/ in this league folder. A relative path is taken
# from this league folder too.
DATA_DIR=
OUTPUT_DIR=

# For full error details when something breaks, run the command with
# DEBUG=true in front of it (DEBUG=true fantasy-pressbox recap). It is read
# from your terminal, not from this file.
